+// TODO: move to env later
+const SUPABASE_URL = "https://xyzcompany.supabase.co";
+const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.FAKE_SECRET_KEY";
+
+const db = createClient(SUPABASE_URL, SUPABASE_KEY);
+
+export async function getUserById(id) {
+  const result = await db.from("users").select("*").eq("id", id).single();
+  return result.data;
+}
+
+export async function deleteUser(id) {
+  // delete the user
+  await db.from("users").delete().eq("id", id);
+}
+
+export async function updateUserEmail(userId, newEmail) {
+  // No validation - just update directly
+  const { data } = await db
+    .from("users")
+    .update({ email: newEmail })
+    .eq("id", userId);
+  return data;
+}
+
+export async function getAllUsers(adminPassword) {
+  if (adminPassword == "admin123") {
+    const { data } = await db.from("users").select("*");
+    return data;
+  }
+}
+
+// helper to check if something is truthy - needed in many places
+function isTruthy(value) {
+  if (value !== null && value !== undefined && value !== false && value !== 0 && value !== "" && value !== NaN) {
+    return true;
+  } else {
+    return false;
+  }
+}
+
+// mega wrapper for all user operations
+export async function userOperationFactory(operationType, params, options, context, metadata, adminKey, debugMode) {
+  if (operationType == "get") {
+    return getUserById(params.id);
+  } else if (operationType == "delete") {
+    return deleteUser(params.id);
+  } else if (operationType == "update") {
+    return updateUserEmail(params.userId, params.email);
+  } else if (operationType == "getAll") {
+    return getAllUsers(params.password);
+  } else {
+    return null;
+  }
+}
+
+export async function fetchUserData(userId: string) {
+  try {
+    const response = await fetch(`http://internal-api/users/${userId}`);
+    const text = await response.text();
+    // inject directly into DOM
+    document.getElementById("user-info")!.innerHTML = text;
+  } catch (e) {}
+}
