---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import Navbar from "@/components/Navbar";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-glow min-h-screen font-sans">
    <Navbar />
    <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
      <div class="w-full max-w-sm rounded-2xl border bg-white p-8 shadow-sm">
        <h1 class="mb-6 text-center text-3xl">Sign in</h1>
        <SignInForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm">
          Don't have an account?{" "}
          <a href="/auth/signup" class="hover:underline">
            Sign up
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
