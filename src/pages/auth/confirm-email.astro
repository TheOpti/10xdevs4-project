---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar";
import { CheckCircle, Mail } from "lucide-react";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      Icon: CheckCircle,
      iconColor: "text-green-500",
      heading: "Registration successful",
      description: ["Your account has been created.", "You can now sign in."],
      linkText: "Go to sign in",
    }
  : {
      Icon: Mail,
      iconColor: "text-blue-500",
      heading: "Check your email",
      description: ["We've sent a confirmation link to your email address.", "Click it to activate your account."],
      linkText: "Back to sign in",
    };

const { Icon, iconColor } = content;
---

<Layout title={content.heading}>
  <div class="bg-glow min-h-screen font-sans">
    <Navbar />
    <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
      <div class="w-full max-w-sm rounded-2xl border bg-white p-8 text-center shadow-sm">
        <div class="mb-4 flex justify-center">
          <Icon className={`h-12 w-12 ${iconColor}`} strokeWidth={1.5} />
        </div>
        <h1 class="mb-3 text-2xl font-bold">{content.heading}</h1>
        <div class="mb-6 space-y-1 text-sm text-gray-500">
          {content.description.map((line) => (
            <p>{line}</p>
          ))}
        </div>
        <a href="/auth/signin" class="text-sm hover:underline">
          {content.linkText}
        </a>
      </div>
    </div>
  </div>
</Layout>
