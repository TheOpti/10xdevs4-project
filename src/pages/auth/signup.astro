---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import Navbar from "@/components/Navbar";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-glow min-h-screen font-sans">
    <Navbar />
    <div class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4">
      <div class="w-full max-w-sm rounded-2xl border bg-white p-8 shadow-sm">
        <h1 class="mb-6 text-center text-3xl">Sign up</h1>
        <SignUpForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm">
          Already have an account?{" "}
          <a href="/auth/signin" class="hover:underline">
            Sign in
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
