---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell";
import SavedFlashcardSet from "@/components/flashcards/SavedFlashcardSet";
import SetTagEditor from "@/components/flashcards/SetTagEditor";
import { createFlashcardRepository } from "@/lib/flashcards";
import { formatCatalogHref, loadSetView, parseCatalogFilter } from "@/lib/flashcard-views";

const filter = parseCatalogFilter(Astro.url.search);
const backHref = formatCatalogHref(filter);

const view = await loadSetView(createFlashcardRepository(Astro.request.headers, Astro.cookies), Astro.params.setId);
if (view.status === "not-found") Astro.response.status = 404;
if (view.status === "unavailable") Astro.response.status = 503;
---

<Layout title={view.status === "ready" ? view.set.title : "Set unavailable"}>
  <AppShell email={Astro.locals.user?.email} newSetHref="/dashboard/new">
    <a href={backHref} class="text-primary mb-6 inline-block text-sm hover:underline">
      Back to collections
    </a>
    {view.status === "ready" ? (
      <div class="space-y-6">
        <SetTagEditor setId={view.set.id} initialTags={view.set.tags} client:load />
        <SavedFlashcardSet title={view.set.title} cards={view.set.cards} client:load />
      </div>
    ) : (
      <section>
        <h1 class="text-2xl font-semibold">
          {view.status === "not-found" ? "Set not found" : "Could not load this set"}
        </h1>
        <p class="text-muted-foreground mt-3">
          {view.status === "not-found"
            ? "This set is not available to your account."
            : "Your cards could not be loaded. Please try again."}
        </p>
        {view.status === "unavailable" && (
          <a href={Astro.url.pathname} class="text-primary mt-4 inline-block underline">
            Retry loading set
          </a>
        )}
      </section>
    )}
  </AppShell>
</Layout>
