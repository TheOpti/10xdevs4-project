{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/lint-edited-file.mjs",
            "commandWindows": "node .codex/hooks/lint-edited-file.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/end-of-turn.mjs",
            "commandWindows": "node .codex/hooks/end-of-turn.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
